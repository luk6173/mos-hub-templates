{
  "name": "Baïkal",
  "repo": "ghcr.io/aalmenar/baikal:latest",
  "registry": "https://github.com/xiao-villamor/PrintStash/pkgs/container/printstash-api",
  "network": "bridge",
  "custom_ip": "",
  "default_shell": "bash",
  "privileged": false,
  "no_autoupdate": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": "",
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/Joshndroid/joshndroid-unraid-docker-templates/main/icons/baikal.png",
  "category": [ "Productivity" ],
  "project": "https://github.com/sabre-io/Baikal",
  "support": "https://github.com/sabre-io/Baikal/issues",  
  "description": "Baïkal is a lightweight CalDAV+CardDAV server",
  "paths": [
    {
      "name": "Config",
      "mode": "rw",
      "host": "/mnt/appdata/baikal/config",
      "container": "/var/www/baikal/config",
      "description": ""
    },
    {
      "name": "Specific",
      "mode": "rw",
      "host": "/mnt/appdata/baikal/specific",
      "container": "/var/www/baikal/Specific",
      "description": ""
    }
  ],
  "ports": [
    {
      "name": "Container Port",
      "protocol": "tcp",
      "host": "80",
      "container": "80",
      "description": " "
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}