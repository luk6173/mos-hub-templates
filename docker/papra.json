{
  "name": "Papra",
  "repo": "ghcr.io/papra-hq/papra:latest",
  "registry": "https://github.com/papra-hq/papra/pkgs/container/papra",
  "network": "bridge",
  "custom_ip": "",
  "default_shell": "bash",
  "privileged": false,
  "no_autoupdate": false,
  "extra_parameters": "--user=500:500",
  "post_parameters": "",
  "web_ui_url": "http://[IP]:[PORT:1221]",
  "icon": "https://raw.githubusercontent.com/egnerdata/unraid-docker-templates/main/icons/papra.png",
  "category": [ "Productivity" ],
  "project": "https://github.com/papra-hq/papra",
  "support": "https://github.com/papra-hq/papra/issues",  
  "description": "Papra is a lightweight document management solution (DMS) that automatically imports, stores, and organizes your files. A simpler alternative to Paperless.\n\nREQUIRED: Create Directory for Papra data:\nmkdir -p /mnt/appdata/papra/{db,documents}",
  "paths": [
    {
      "name": "App Data",
      "mode": "rw",
      "host": "/mnt/user/appdata/papra",
      "container": "/app/app-data",
      "description": "Papra App Data"
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "protocol": "tcp",
      "host": "1221",
      "container": "1221",
      "description": "WebUI Port",
      "required": true
    }
  ],
  "variables": [
    {
      "name": "App Base URL",
      "key": "APP_BASE_URL",
      "value": "http://localhost:1221",
      "mask": false,
      "description": "Replace with IP adress/domain of server",
      "required": true
    },
    {
      "name": "Auth_Secret",
      "key": "AUTH_SECRET",
      "value": "",
      "mask": false,
      "description": "The secret for the auth, it should be at least 32 characters long. Generate with openssl rand -hex 48",
      "required": true
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}